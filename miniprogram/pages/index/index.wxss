/* 隐私授权仅在用户主动请求运动或定位时出现。 */
.privacy-overlay{position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;padding:42rpx;background:rgba(49,65,45,.4)}
.privacy-sheet{width:100%;max-width:640rpx;padding:38rpx 30rpx 30rpx;background:#fffdf5;border-radius:32rpx;text-align:center;box-shadow:0 20rpx 80rpx rgba(39,66,38,.16)}
.privacy-pet{width:130rpx;height:130rpx;display:block;margin:0 auto 10rpx}
.privacy-title{font-size:32rpx;font-weight:700;color:#486447}
.privacy-copy{font-size:24rpx;line-height:1.9;color:#85917c;text-align:left;margin-top:22rpx}
.privacy-contract{color:#5b8057;font-size:24rpx;padding:22rpx 0;line-height:1.6;white-space:normal;text-decoration:underline}
.privacy-actions{display:flex;gap:16rpx;margin-top:8rpx}
.privacy-actions button{flex:1;font-size:25rpx;line-height:1.4;padding:24rpx 12rpx;border-radius:17rpx}
.privacy-decline{background:#edf0e5;color:#85917c}
.privacy-agree{background:#547c5b;color:#fff}
.privacy-hint{color:#a9b09f;font-size:20rpx;line-height:1.7;margin-top:20rpx}
