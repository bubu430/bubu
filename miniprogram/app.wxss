page { background: #f8f8f2; color: #35483f; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif; font-size: 28rpx; }
button { padding: 0; margin: 0; font-size: inherit; line-height: inherit; border-radius: 0; background: none; color: inherit; }
button::after { border: none; }
view, button { box-sizing: border-box; }
